rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "customer";
    }

    function isStaff() {
      return userRole() in ["moderator", "admin", "developer"];
    }

    // Every role that may open the admin panel, INCLUDING the read-only
    // `teacher`. Mirrors STAFF_ROLES in api/_lib/roles.js. Used only to grant
    // READS of server-published, learner-only projections — it never grants a
    // write anywhere, so widening it cannot widen mutation rights.
    function isPanelStaff() {
      return userRole() in ["teacher", "moderator", "admin", "developer"];
    }

    // ------------------------------------------------------------------
    // WHAT A LEARNER MAY WRITE TO THEIR OWN DOCUMENT
    // ------------------------------------------------------------------
    // `courses` used to be here as a single opaque key. Because an update with
    // dotted paths (courses.B1.finalExamPassed) only ever reports `courses` as
    // the affected top-level key, that one entry let the owner write ANY field
    // of ANY course — including the flag the certificate backend trusts. A
    // customer could set courses.B1.finalExamPassed = true from the console and
    // collect a real, numbered certificate.
    //
    // `courses` is still writable, but the courseUpdateAllowed() check below
    // restricts WHICH sub-fields may move. Progress and exam verdicts are
    // written exclusively by /api/progress through the Admin SDK, which is not
    // subject to these rules.
    //
    // Root `completedTopics` is legacy: it is still READ by old profiles, and
    // reads are unaffected by any of this — it is simply no longer writable.
    function ownerMutableKeys() {
      return [
        "courses",
        "lastActivity",
        "forcePasswordChange",
        "lastPasswordChangeAt",
        "updatedAt",
        "agreementAccepted",
        "agreementAcceptedAt"
      ];
    }

    // The only sub-fields of a course a learner may author. Everything absent
    // from this list — completedTopics, finalExamPassed, finalExamScore,
    // finalExamCompletedAt, courseCompleted, certificateUnlocked,
    // certificateNumber — is server-only.
    function courseSafeKeys() {
      return ["vocabulary", "lastUpdated"];
    }

    function courseCodes() {
      return ["A1", "A2", "B1", "B2"];
    }

    // True when this course's map either did not change, or changed only in
    // safe sub-fields. Written to survive absence at every level: a new account
    // has no `courses`, a new course has no map, and diff() on a missing map is
    // not something to rely on — so each level is guarded with an explicit
    // existence check before it is compared.
    function courseChangeAllowed(code) {
      return !( ('courses' in request.resource.data) && (request.resource.data.courses is map)
                && (code in request.resource.data.courses)
                && (request.resource.data.courses[code] is map) )
        ? true
        : ( !( ('courses' in resource.data) && (resource.data.courses is map)
               && (code in resource.data.courses) && (resource.data.courses[code] is map) )
            // The course map is being CREATED. Only safe keys may appear in it.
            ? request.resource.data.courses[code].keys().hasOnly(courseSafeKeys())
            // It already existed: only safe keys may have moved.
            : request.resource.data.courses[code]
                .diff(resource.data.courses[code])
                .affectedKeys().hasOnly(courseSafeKeys()) );
    }

    function coursesUpdateAllowed() {
      return courseChangeAllowed("A1")
        && courseChangeAllowed("A2")
        && courseChangeAllowed("B1")
        && courseChangeAllowed("B2");
    }

    function ownerUpdateAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerMutableKeys())
        && coursesUpdateAllowed();
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if false;
      allow delete: if false;
      allow update: if isOwner(userId) && ownerUpdateAllowed();

      match /quizResults/{resultId} {
        allow read, write: if isOwner(userId);
      }

      // Certificates registry (per user). Issued ONLY server-side via the Admin
      // SDK (which bypasses these rules), so they can never be forged or altered
      // from the client. The owner — and staff — may read their own records;
      // clients may never write.
      match /certificates/{certificateId} {
        allow read: if isOwner(userId) || isStaff();
        allow write: if false;
      }

      // Learning analytics event stream + aggregates. Written ONLY server-side
      // via the Admin SDK (POST /api/analytics?action=track), read ONLY server
      // side by staff endpoints. Students may never read or write analytics —
      // not even their own — so no learner can enumerate or forge activity.
      match /events/{eventId} {
        allow read, write: if false;
      }
      match /analytics/{docId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    // Legacy course-page activity trail (demo pages call logActivity()).
    //
    // The previous rule accepted ANY string in `userEmail` from ANY signed-in
    // account, so any learner could forge unlimited entries attributing actions
    // to somebody else — log poisoning plus an unbounded, un-ratelimited write
    // path into a staff-readable collection. A log entry may now only be filed
    // under the caller's OWN identity, and only with bounded fields.
    match /activityLogs/{logId} {
      allow create: if isSignedIn() &&
        request.resource.data.userEmail is string &&
        request.resource.data.userEmail == request.auth.token.email &&
        request.resource.data.action is string &&
        request.resource.data.action.size() <= 500;
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------------
    // REALTIME ADMIN PROJECTIONS (Stage 6/7)
    // ---------------------------------------------------------------------
    // studentPulse/{uid} is a narrow, LEARNER-ONLY mirror of the row the admin
    // list renders, republished by the Admin SDK whenever a student acts. It is
    // what makes the panel live without polling. Staff read; NOBODY writes from
    // a client — the server bypasses these rules.
    //
    // Because staff accounts are never projected into this collection, a
    // `teacher` subscribing to all of it still sees exactly what canViewUser()
    // would have allowed them to see: learners, and nothing else.
    match /studentPulse/{userId} {
      allow read: if isPanelStaff();
      allow write: if false;
    }

    // Pre-aggregated platform counters (daily activity, per-topic difficulty).
    // Contains no personal data at all. Read by the Global Analytics page;
    // written only by the ingest path via the Admin SDK.
    match /analyticsGlobal/{docId} {
      allow read: if isPanelStaff();
      allow write: if false;
    }

    // Admin audit trail. Written server-side via the Admin SDK only (which
    // bypasses these rules); clients may never write. Staff may read for review.
    match /adminAuditLogs/{logId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // Global certificate registry + monotonic number counters. Written and read
    // ONLY by the Admin SDK (server). The verification page and admin search go
    // through server endpoints, never directly — so clients have no access and
    // sequential numbers cannot be enumerated from the client.
    match /certificateRegistry/{certificateNumber} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
